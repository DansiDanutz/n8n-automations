# API Rate Limiter Configuration

# Server
PORT=8000

# Rate Limiting Defaults
DEFAULT_RATE_LIMIT=100          # Max requests per window
DEFAULT_WINDOW_SECONDS=60       # Window size in seconds

# Redis (optional — uses in-memory if not set)
REDIS_URL=                      # redis://localhost:6379/0

# Security
ADMIN_API_KEY=replace-with-at-least-32-random-characters  # Required for /rules, /clients, /analytics
API_KEY_HEADER=X-API-Key        # Header name for API key identification

# Alerts (optional)
ALERT_WEBHOOK_URL=              # POST webhook when limits exceeded
