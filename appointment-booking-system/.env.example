# Server Configuration
PORT=8001
HOST=0.0.0.0

# Business Configuration
BUSINESS_NAME=Professional Services
TIMEZONE=UTC
DEFAULT_DURATION=60
BUFFER_TIME=15

# Email Configuration (for reminders)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_email@gmail.com
SMTP_PASSWORD=your_app_password
FROM_EMAIL=your_email@gmail.com

# Database (optional - uses in-memory by default)
DATABASE_URL=sqlite:///bookings.db
# DATABASE_URL=postgresql://user:password@localhost/bookings

# Security
ADMIN_API_KEY=replace-with-at-least-32-random-characters
ADMIN_EMAIL=admin@yourcompany.com
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Working Hours (JSON format)
WORKING_HOURS_MONDAY={"start": "09:00", "end": "17:00"}
WORKING_HOURS_TUESDAY={"start": "09:00", "end": "17:00"}
WORKING_HOURS_WEDNESDAY={"start": "09:00", "end": "17:00"}
WORKING_HOURS_THURSDAY={"start": "09:00", "end": "17:00"}
WORKING_HOURS_FRIDAY={"start": "09:00", "end": "17:00"}
WORKING_HOURS_SATURDAY={"start": "10:00", "end": "14:00"}
WORKING_HOURS_SUNDAY={"start": "closed", "end": "closed"}

# Logging
LOG_LEVEL=INFO
LOG_FILE=bookings.log
