# Webhook Relay & Logger Configuration

# Application Settings
APP_NAME="Webhook Relay & Logger"
APP_VERSION="1.0.0"
DEBUG=false
HOST=0.0.0.0
PORT=8000

# Security
JWT_SECRET_KEY=replace-with-at-least-32-random-characters
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Database
DATABASE_URL=postgresql://user:password@localhost/webhook_relay_logger
REDIS_URL=redis://localhost:6379

# Webhook Settings
DEFAULT_TIMEOUT_SECONDS=30
MAX_RETRY_ATTEMPTS=3
MAX_PAYLOAD_SIZE_MB=10
RATE_LIMIT_PER_MINUTE=60

# Storage
LOG_RETENTION_DAYS=30
CLEANUP_INTERVAL_HOURS=24

# External Services
NOTIFICATION_WEBHOOK_URL=https://hooks.slack.com/your-webhook-url
ANALYTICS_ENABLED=true

# Dashboard
DASHBOARD_ENABLED=true
DASHBOARD_REFRESH_INTERVAL_SECONDS=30

# Security Headers
ENABLE_CORS=true
ALLOWED_ORIGINS=*
ALLOWED_METHODS=GET,POST,PUT,DELETE,OPTIONS
ALLOWED_HEADERS=*

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json
LOG_FILE=/app/logs/webhook-relay.log

# Monitoring
ENABLE_METRICS=true
METRICS_PORT=9090

# Development
RELOAD_ON_CHANGE=false
